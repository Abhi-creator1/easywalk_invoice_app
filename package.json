{
  "name": "easywalk-docs",
  "version": "2.0.0",
  "description": "EasyWalk Physiotherapy documentation desktop app (invoices, treatment protocols, certificates, IPD patients). Offline Electron build of the web app on master.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node tools/run-tests.js"
  },
  "author": "EasyWalk Physiotherapy and Rehabilitation Centre",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.easywalk.docs",
    "productName": "EasyWalk Documentation",
    "files": [
      "electron/**/*",
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "manifest.json",
      "sw.js"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/logo.png"
    }
  }
}
